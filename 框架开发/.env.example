# 复制为 .env 后按本机情况改值。.env 已被仓库根 .gitignore 排除，不要提交。

NODE_ENV=development
PORT=3000

# ── MySQL（005数据库脚本/01_schema.sql 建出来的库）────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=daily_ledger
DB_POOL_SIZE=8

# ── 密钥：各生成一份独立的随机值，不要复用 ──────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
TOKEN_PEPPER=

# ── Token 有效期（PRD ACC-02：Access 2 小时 + Refresh 30 天滚动）────
ACCESS_TTL_SEC=7200
REFRESH_TTL_SEC=2592000

# ── argon2id 参数（OWASP 下限；调高前先压 P95 ≤ 800ms）──────────────
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32

# ── 限流与锁定 ─────────────────────────────────────────────────────
LOGIN_MAX_FAILS_USERNAME=5
LOGIN_MAX_FAILS_IP=30
LOGIN_FAIL_WINDOW_SEC=900
REGISTER_IP_LIMIT=10
REGISTER_IP_WINDOW_SEC=3600
REGISTER_DEVICE_LIMIT=5
REGISTER_DEVICE_WINDOW_SEC=3600

# 只有确认服务站在 Nginx/网关后面才设 true，否则 IP 频控可被伪造 X-Forwarded-For 绕过
TRUST_PROXY=false

# 允许跨域调用 /api/v1/auth/* 的前端来源，逗号分隔；本机联调可写 *
# 只在你坚持用 python3 -m http.server 8080 单独起页面时才需要；页面由下面的 STATIC_DIR 同源托管时不走跨域
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 原型页面目录，默认是同级仓库里的 ../004前端开发/画面设计；设为空字符串（STATIC_DIR=）则只跑接口、不托管页面
# STATIC_DIR=
